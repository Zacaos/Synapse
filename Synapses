CPF_REGION_DDD_MAP = {
    1: [61, 62, 64, 65, 66, 67, 63],
    2: [91, 93, 94, 92, 97, 68, 96, 69, 95],
    3: [85, 88, 98, 99, 86, 89],
    4: [81, 87, 84, 83, 82],
    5: [71, 73, 74, 75, 77, 79],
    6: [31, 32, 33, 34, 35, 37, 38],
    7: [21, 22, 24, 27, 28],
    8: [11, 12, 13, 14, 15, 16, 17, 18, 19],
    9: [41, 42, 43, 44, 45, 46, 47, 48, 49],
    0: [51, 53, 54, 55]
}

HIGH_RISK_BINS = ["411111", "555555", "400012", "520082"]

def check_cpf_ddd_match(cpf_str: str, ddd: int) -> bool:
    digits = ''.join(filter(str.isdigit, str(cpf_str)))
    if len(digits) < 11:
        return False
    ninth_digit = int(digits[8])
    expected_ddds = CPF_REGION_DDD_MAP.get(ninth_digit, [])
    return int(ddd) in expected_ddds

