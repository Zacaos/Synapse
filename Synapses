@st.cache_data
def generate_sample_payload(n_rows=300):
    np.random.seed(42)
    base_time = datetime.now() - timedelta(days=5)
    
    ispbs = [
        ("00000000", "Banco do Brasil"),
        ("60701190", "Itaú Unibanco"),
        ("18236120", "Nu Pagamentos"),
        ("90400888", "Banco Santander"),
        ("60746948", "Bradesco"),
        ("00360305", "Caixa Econômica")
    ]
    
    cpfs_pool = [
        "39481204812", "10928374890", "84726193844", "55829103721",
        "19283746519", "73645182601", "66473829104", "44920183855",
        "91827364822", "30291847811", "22019283340", "51920384710"
    ]
    
    rows = []
    for i in range(n_rows):
        tx_time = base_time + timedelta(minutes=int(np.random.randint(1, 7200)))
        orig_ispb, orig_bank = ispbs[np.random.randint(0, len(ispbs))]
        dest_ispb, dest_bank = ispbs[np.random.randint(0, len(ispbs))]
        
        origin_cpf = np.random.choice(cpfs_pool)
        if np.random.rand() < 0.35:
            dest_cpf = origin_cpf
        else:
            dest_cpf = f"{np.random.randint(100000000, 999999999)}{np.random.randint(10, 99)}"
            
        payment_method = np.random.choice(["PIX", "CREDIT_CARD"], p=[0.78, 0.22])
        val_choice = np.random.choice(["low", "mid", "high"], p=[0.45, 0.30, 0.25])
        
        if val_choice == "low":
            valor = round(np.random.uniform(25.0, 490.0), 2)
        elif val_choice == "mid":
            valor = round(np.random.uniform(501.0, 995.0), 2)
        else:
            valor = round(np.random.uniform(1005.0, 6500.0), 2)
            
        e2e_id = f"E{orig_ispb}{tx_time.strftime('%Y%m%d%H%M')}{10000000000 + i}"
        
        ninth_digit = int(origin_cpf[8])
        valid_ddds = CPF_REGION_DDD_MAP.get(ninth_digit, [11])
        ddd = np.random.choice(valid_ddds) if np.random.rand() < 0.72 else np.random.choice([11, 21, 85, 92, 61, 41])
        
        card_bin = "N/A" if payment_method == "PIX" else np.random.choice(["411111", "543210", "555555", "453211", "400012"])
        recorrencia_24h = int(np.random.choice([1, 2, 3, 4, 6, 8], p=[0.50, 0.20, 0.12, 0.08, 0.06, 0.04]))
        geo_dist_km = round(np.random.choice([2.5, 12.0, 45.0, 380.0, 1250.0], p=[0.55, 0.20, 0.10, 0.08, 0.07]), 1)
        device_trust = np.random.choice(["Trusted", "New_Device", "Emulator_Root", "VPN_Proxy"], p=[0.68, 0.18, 0.07, 0.07])
        
        rows.append({
            "endToEndId": e2e_id,
            "timestamp": tx_time.strftime("%Y-%m-%d %H:%M:%S"),
            "paymentMethod": payment_method,
            "valor": valor,
            "originDocumentNumber": origin_cpf,
            "destinationDocumentNumber": dest_cpf,
            "originISPB": orig_ispb,
            "originBank": orig_bank,
            "destinationISPB": dest_ispb,
            "destinationBank": dest_bank,
            "campoLivre": np.random.choice(["Transferencia Pix", "QrCode Dinamico", "Compra E-commerce", "Fornecedor"]),
            "accountDDD": ddd,
            "cardBIN": card_bin,
            "txCount24h": recorrencia_24h,
            "geoDistanceKm": geo_dist_km,
            "deviceStatus": device_trust
        })
    return pd.DataFrame(rows)

