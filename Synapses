# 4. MOTOR DE RISCO (SCORE 0 A 99)
# ==============================================================================
def run_synapse_backtest(
    df: pd.DataFrame,
    w_diff_doc_500: int = 35,
    w_recurrence_1000: int = 30,
    w_cpf_ddd_mismatch: int = 15,
    w_device_geo: int = 20,
    w_card_bin: int = 25,
    th_approve: int = 30,
    th_manual: int = 60,
    th_cautelar: int = 80
) -> pd.DataFrame:
    df_out = df.copy()
    scores, decisions, reasons_list, same_holder_flags, cpf_ddd_flags = [], [], [], [], []
    
    for _, row in df_out.iterrows():
        score = 0
        reasons = []
        
        orig_doc = str(row.get("originDocumentNumber", "")).strip()
        dest_doc = str(row.get("destinationDocumentNumber", "")).strip()
        valor = float(row.get("valor", 0.0))
        tx_24h = int(row.get("txCount24h", 1))
        ddd = int(row.get("accountDDD", 11))
        method = str(row.get("paymentMethod", "PIX"))
        card_bin = str(row.get("cardBIN", "N/A"))
        geo_km = float(row.get("geoDistanceKm", 0.0))
        device = str(row.get("deviceStatus", "Trusted"))
        
        is_same_holder = (orig_doc == dest_doc) and (orig_doc != "")
        same_holder_flags.append(is_same_holder)
        
        cpf_ddd_ok = check_cpf_ddd_match(orig_doc, ddd)
        cpf_ddd_flags.append("Compatível" if cpf_ddd_ok else "Divergente")
        
        if is_same_holder and method == "PIX":
            score = 5
            reasons.append("Mesma Titularidade (Pix Seguro)")
        else:
            if valor > 500:
                score += w_diff_doc_500
                reasons.append(f"Titularidade Distinta + Valor > R$ 500 (+{w_diff_doc_500} pts)")
            else:
                score += 10
                
            if valor > 1000 and tx_24h >= 3:
                score += w_recurrence_1000
                reasons.append(f"Valor > R$ 1k c/ Recorrência ({tx_24h}x) (+{w_recurrence_1000} pts)")
                
            if not cpf_ddd_ok:
                score += w_cpf_ddd_mismatch
                reasons.append(f"Divergência DDD ({ddd}) vs Região Fiscal CPF (+{w_cpf_ddd_mismatch} pts)")
                
            if device in ["Emulator_Root", "VPN_Proxy"] or geo_km > 300:
                score += w_device_geo
                reasons.append(f"Anomalia Device ({device}) / Geo ({geo_km}km) (+{w_device_geo} pts)")
            elif device == "New_Device":
                score += int(w_device_geo * 0.5)
                reasons.append(f"Novo Dispositivo Detectado (+{int(w_device_geo * 0.5)} pts)")
                
            if method == "CREDIT_CARD" and card_bin in HIGH_RISK_BINS:
                score += w_card_bin
                reasons.append(f"BIN de Cartão em Lista Restritiva ({card_bin}) (+{w_card_bin} pts)")
                
        # Garantir score entre 0 e 99 (conforme solicitado)
        score = min(99, max(0, int(score)))
        
        if is_same_holder and method == "PIX" and device == "Trusted":
            decision = "APROVADO"
        elif valor > 1000 and tx_24h >= 3 and score < th_cautelar:
            decision = "REVISÃO MANUAL"
        elif score <= th_approve:
            decision = "APROVADO"
        elif score <= th_manual:
            decision = "REVISÃO MANUAL"
        elif score < th_cautelar:
            decision = "BLOQUEIO CAUTELAR (72h)"
        else:
            decision = "REPROVADO / FRAUDE"
            
        if not reasons:
            reasons.append("Comportamento Normal")
            
        scores.append(score)
        decisions.append(decision)
        reasons_list.append(" | ".join(reasons))
        
    df_out["sameHolder"] = same_holder_flags
    df_out["cpfDddStatus"] = cpf_ddd_flags
    df_out["riskScore"] = scores
    df_out["recommendedAction"] = decisions
    df_out["aiReasoning"] = reasons_list
    return df_out

